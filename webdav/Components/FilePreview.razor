@using Microsoft.JSInterop
@using WebDav.Services
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseOnBackdrop">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-eye"></i> Preview: @FileName
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body @(IsImage ? "image-modal-body" : IsPdf ? "pdf-modal-body" : null)">
                    @if (isLoading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (IsImage)
                    {
                        <div class="image-preview-container @(showOriginal ? "original-size" : null)" @ref="imageContainer">
                            @if (!string.IsNullOrEmpty(CurrentImageUrl))
                            {
                                <img src="@CurrentImageUrl" alt="@FileName" class="preview-image" @ref="imageElement" />
                            }
                            else
                            {
                                <div class="text-center p-4">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">Preparing preview...</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (IsPdf)
                    {
                        <iframe src="@PdfUrl" class="pdf-preview-frame" title="PDF preview: @FileName"></iframe>
                    }
                    else if (!string.IsNullOrEmpty(Content))
                    {
                        @if (IsMarkdown)
                        {
                            <div class="markdown-preview">
                                @((MarkupString)RenderMarkdown(Content))
                            </div>
                        }
                        else
                        {
                            <pre class="code-preview"><code class="language-@FileExtension">@Content</code></pre>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Unable to load file content.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <span class="text-muted me-auto">
                        @FileExtension.ToUpper() file
                        @if (IsImage && !string.IsNullOrEmpty(ImagePath))
                        {
                            <span class="ms-2">
                                · Image
                                @if (ImageWidth > 0 && ImageHeight > 0)
                                {
                                    <span> (@ImageWidth × @ImageHeight)</span>
                                }
                            </span>
                        }
                    </span>
                    @if (IsImage)
                    {
                        <button type="button" class="btn btn-outline-secondary image-size-toggle"
                                @onclick="ToggleOriginalSize" disabled="@(!canShowOriginal)"
                                title="@(canShowOriginal ? (showOriginal ? "Fit to window" : "Show original size") : "Image already fits the preview area")"
                                aria-label="@(showOriginal ? "Fit to window" : "Show original size")">
                            <i class="bi @(showOriginal ? "bi-zoom-out" : "bi-zoom-in")"></i>
                        </button>
                    }
                    @if (IsPdf)
                    {
                        <a class="btn btn-outline-primary" href="@PdfUrl" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right"></i> Open in new tab
                        </a>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string FileName { get; set; } = string.Empty;

    [Parameter]
    public string FileExtension { get; set; } = string.Empty;

    [Parameter]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public string ImagePath { get; set; } = string.Empty;

    [Parameter]
    public int ImageWidth { get; set; }

    [Parameter]
    public int ImageHeight { get; set; }

    [Parameter]
    public bool IsImage { get; set; }

    [Parameter]
    public bool IsPdf { get; set; }

    [Parameter]
    public string PdfPath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool isLoading = false;
    private bool measurementPending;
    private bool canShowOriginal;
    private bool showOriginal;
    private bool escapeRegistered;
    private bool panZoomAttached;
    private bool panZoomUpdatePending;
    private string measuredImagePath = string.Empty;
    private string fitImageUrl = string.Empty;
    private ElementReference imageContainer;
    private ElementReference imageElement;
    private DotNetObjectReference<FilePreview>? componentReference;

    private bool IsMarkdown => FileExtension is "md" or "markdown";
    private string PdfUrl => $"/api/pdf?path={Uri.EscapeDataString(PdfPath)}";
    private string OriginalImageUrl => BuildImageUrl(ImagePath);
    private string CurrentImageUrl => showOriginal ? OriginalImageUrl : fitImageUrl;

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            measuredImagePath = string.Empty;
            fitImageUrl = string.Empty;
            showOriginal = false;
            canShowOriginal = false;
            measurementPending = false;
            panZoomAttached = false;
            panZoomUpdatePending = false;
            return;
        }

        if (IsVisible && IsImage && !string.Equals(measuredImagePath, ImagePath, StringComparison.Ordinal))
        {
            measuredImagePath = ImagePath;
            fitImageUrl = string.Empty;
            showOriginal = false;
            canShowOriginal = false;
            measurementPending = !string.IsNullOrEmpty(ImagePath);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (IsVisible && !escapeRegistered)
            {
                componentReference ??= DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("filePreview.registerEscape", componentReference);
                escapeRegistered = true;
            }
            else if (!IsVisible && escapeRegistered)
            {
                await JSRuntime.InvokeVoidAsync("filePreview.unregisterEscape");
                escapeRegistered = false;
            }

            if (IsVisible && IsImage && measurementPending)
            {
                var size = await JSRuntime.InvokeAsync<ElementSize>("filePreview.getSize", imageContainer);
                var maxWidth = Math.Max(64, (int)Math.Floor(size.Width) - 40);
                var maxHeight = Math.Max(64, (int)Math.Floor(size.Height) - 40);
                canShowOriginal = ImageWidth > maxWidth * 1.25 || ImageHeight > maxHeight * 1.25;
                fitImageUrl = canShowOriginal
                    ? BuildImageUrl(ImagePath, maxWidth, maxHeight)
                    : OriginalImageUrl;
                measurementPending = false;
                StateHasChanged();
            }

            if (IsVisible && IsImage && panZoomUpdatePending)
            {
                if (showOriginal)
                {
                    await JSRuntime.InvokeVoidAsync("filePreview.attachPanZoom", imageContainer, imageElement);
                    panZoomAttached = true;
                }
                else if (panZoomAttached)
                {
                    await JSRuntime.InvokeVoidAsync("filePreview.detachPanZoom", imageContainer, imageElement);
                    panZoomAttached = false;
                }

                panZoomUpdatePending = false;
            }
        }
        catch (InvalidOperationException)
        {
            // JavaScript is unavailable during server prerendering; the interactive render retries.
        }
        catch (JSDisconnectedException)
        {
            // The browser connection closed while the preview was being updated.
        }
    }

    private void ToggleOriginalSize()
    {
        if (canShowOriginal)
        {
            showOriginal = !showOriginal;
            panZoomUpdatePending = true;
        }
    }

    private static string BuildImageUrl(string path, int? maxWidth = null, int? maxHeight = null)
    {
        var url = $"/api/image?path={Uri.EscapeDataString(path)}";
        return maxWidth.HasValue && maxHeight.HasValue
            ? $"{url}&maxWidth={maxWidth.Value}&maxHeight={maxHeight.Value}"
            : url;
    }

    [JSInvokable]
    public Task CloseFromEscape()
    {
        return Close();
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task CloseOnBackdrop()
    {
        // Close when clicking on the backdrop (dark overlay)
        await Close();
    }

    private string RenderMarkdown(string markdown)
    {
        // Basic markdown rendering without external libraries
        // For a more robust solution, consider using Markdig library
        var html = markdown;

        // Headers
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h3>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h2>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^# (.+)$", "<h1>$1</h1>", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Bold and Italic
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"__(.+?)__", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"_(.+?)_", "<em>$1</em>");

        // Code blocks
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code>$1</code>");

        // Links
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[(.+?)\]\((.+?)\)", "<a href=\"$2\">$1</a>");

        // Line breaks
        html = html.Replace("\n\n", "</p><p>").Replace("\n", "<br/>");

        return $"<div class='markdown-content'><p>{html}</p></div>";
    }

    public async ValueTask DisposeAsync()
    {
        if (panZoomAttached)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("filePreview.detachPanZoom", imageContainer, imageElement);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (escapeRegistered)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("filePreview.unregisterEscape");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        componentReference?.Dispose();
    }

    private sealed class ElementSize
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
